
# Python cache files
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Jupyter Notebook
.ipynb_checkpoints/

# Raw and processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Keep only approved sample data in Git
# Review sample data size and licensing before committing

# Machine learning models
saved_models/*
!saved_models/.gitkeep
*.pkl
*.joblib
*.h5
*.keras
*.onnx

# Reports and generated files
reports/figures/*
reports/outputs/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.bak
